{
  "name": "pointer",
  "version": "2.0.0-preview.1",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.26.2"
  },
  "description": "A secure AI chat app crafted for deep thinkers",
  "main": "./out/main/index.js",
  "author": "experdot@foxmail.com",
  "homepage": "https://github.com/experdot/pointer",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache --max-warnings 0 .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "test": "vitest run --project unit --project kernel --project renderer --project renderer-dom",
    "test:watch": "vitest --project unit --project kernel --project renderer --project renderer-dom",
    "test:unit": "vitest run --project unit",
    "test:kernel": "vitest run --project kernel",
    "test:renderer": "vitest run --project renderer --project renderer-dom",
    "test:coverage": "pnpm test --coverage",
    "test:stress": "vitest run --project stress",
    "test:release": "node --test scripts/release.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "smoke:kernel": "node scripts/build-kernel-smoke.mjs && electron out/kernel-smoke.cjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && pnpm check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:release": "node scripts/release.mjs verify",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "release": "pnpm check:release && pnpm build && pnpm release:upload",
    "release:upload": "pnpm check:release && electron-builder --win --publish=always",
    "package:local": "pnpm build && electron-builder --publish=never"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "antd": "^5.26.0",
    "dayjs": "^1.11.13",
    "eventsource-parser": "^3.0.3",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
    "katex": "^0.16.11",
    "mermaid": "^10.9.1",
    "monaco-editor": "^0.55.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "shiki": "^3.21.0",
    "unified": "11.0.5",
    "use-debounce": "^10.0.1",
    "uuid": "^10.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "5.0.4",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "electron-vite": "^3.1.0",
    "electron-window-state": "^5.0.3",
    "esbuild": "0.25.12",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "jsdom": "26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass-embedded": "^1.89.2",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
